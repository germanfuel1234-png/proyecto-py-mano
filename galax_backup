        saturno_ring.set_gl_state('translucent', depth_test=True)
        saturno_ring_idx = i
        break

# --- Iluminación simple (simulada con color) ---
def iluminar(color_hex, factor):
    c = color.Color(color_hex).rgb
    c = np.clip(np.array(c) * factor, 0, 1)
    return c



# --- Animación ---
angle = 0


def update(event):
    global angle
    angle += 0.01
    for i, (nombre, radio, radio_planeta, color_hex, vel, inclinacion, rotacion) in enumerate(PLANETAS):
        orb_angle = angle * vel + i * 0.7
        x = radio * np.cos(orb_angle)
        y = radio * np.sin(orb_angle)
        rot = np.deg2rad(inclinacion)
        z = y * np.sin(rot)
        y = y * np.cos(rot)
        planeta_rot = scene.transforms.MatrixTransform()
        planeta_rot.rotate(angle * rotacion * 360, (0, 1, 0))
        planeta_rot.translate((x, y, z))
        planetas_vispy[i].transform = planeta_rot
        if nombre == "Venus":
            atm_idx = len(PLANETAS)
            if len(planetas_vispy) > atm_idx:
                atmosfera_rot = scene.transforms.MatrixTransform()
                atmosfera_rot.rotate(angle * rotacion * 360, (0, 1, 0))
                atmosfera_rot.translate((x, y, z))
                planetas_vispy[atm_idx].transform = atmosfera_rot
        etiquetas[i].pos = (x, y, z + radio_planeta + 0.2)
        if nombre == "Tierra":
            luna_angle = angle * 0.08 * 30
            lx = x + 0.5 * np.cos(luna_angle)
            ly = y + 0.5 * np.sin(luna_angle)
            lz = z
            luna_rot = scene.transforms.MatrixTransform()
            luna_rot.rotate(angle * 0.2 * 360, (0, 1, 0))
            luna_rot.translate((lx, ly, lz))
            lunas[i].transform = luna_rot
        if nombre == "Saturno" and saturno_ring is not None:
            ring_rot = scene.transforms.MatrixTransform()
            ring_rot.rotate(angle * rotacion * 360, (0, 1, 0))
            ring_rot.translate((x, y, z))
            saturno_ring.transform = ring_rot
        if hasattr(view, 'camera') and hasattr(view.camera, 'distance'):
            if view.camera.distance > 30:
                fondo.visible = True
            else:
                fondo.visible = False
        else:
            fondo.visible = True

# Timer para refrescar la escena y leer la cámara
timer = app.Timer()
timer.connect(update)
timer.start(0.03)

if __name__ == '__main__':
    app.run()

