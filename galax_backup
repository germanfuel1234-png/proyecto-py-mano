# FUNCIÓN PARA CREAR UNA ESFERA TEXTURIZADA COMO MESH

def crear_esfera_texturizada(centro, radio, filas=32, columnas=64):
    """
    Genera una esfera como mesh con texcoords para texturizado UV.
    centro: (x, y, z)
    radio: float
    filas: int (latitudes)
    columnas: int (longitudes)
    """
    vertices = []
    texcoords = []
    indices = []
    for i in range(filas + 1):
        lat = np.pi * i / filas
        for j in range(columnas + 1):
            lon = 2 * np.pi * j / columnas
            x = radio * np.sin(lat) * np.cos(lon) + centro[0]
            y = radio * np.cos(lat) + centro[1]
            z = radio * np.sin(lat) * np.sin(lon) + centro[2]
            vertices.append([x, y, z])
            u = j / columnas
            v = i / filas
            texcoords.append([u, 1 - v])
    for i in range(filas):
        for j in range(columnas):
            p1 = i * (columnas + 1) + j
            p2 = p1 + columnas + 1
            indices.append([p1, p2, p1 + 1])
            indices.append([p2, p2 + 1, p1 + 1])
    return np.array(vertices, np.float32), np.array(indices, np.uint32), np.array(texcoords, np.float32)

