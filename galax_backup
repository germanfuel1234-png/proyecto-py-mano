# --- Aros de Saturno (disco con textura alfa) ---
def crear_disco_texturizado(radio_ext=1.1, radio_int=0.5, segmentos=128, z=0):
    vertices = []
    texcoords = []
    faces = []
    for i in range(segmentos+1):
        theta = 2 * np.pi * i / segmentos
        x_ext = radio_ext * np.cos(theta)
        y_ext = radio_ext * np.sin(theta)
        x_int = radio_int * np.cos(theta)
        y_int = radio_int * np.sin(theta)
        vertices.append([x_ext, y_ext, z])
        texcoords.append([0.5 + 0.5 * np.cos(theta), 0.5 + 0.5 * np.sin(theta)])
        vertices.append([x_int, y_int, z])
        texcoords.append([0.5 + 0.5 * np.cos(theta) * radio_int/radio_ext, 0.5 + 0.5 * np.sin(theta) * radio_int/radio_ext])
    for i in range(segmentos):
        faces.append([i*2, i*2+1, (i*2+2)%((segmentos+1)*2)])
        faces.append([i*2+1, (i*2+3)%((segmentos+1)*2), (i*2+2)%((segmentos+1)*2)])
    return np.array(vertices, np.float32), np.array(faces, np.uint32), np.array(texcoords, np.float32)

saturno_ring_tex = cargar_textura('texturas/2k_saturn_ring_alpha.png')
