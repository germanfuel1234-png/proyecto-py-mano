    # Órbita
    t = np.linspace(0, 2 * np.pi, 200)
    x = radio * np.cos(t)
    y = radio * np.sin(t)
    z = np.zeros_like(t)
    rot = np.deg2rad(inclinacion)
    z = y * np.sin(rot)
    y = y * np.cos(rot)
