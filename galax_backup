# --- Función para cargar texturas RGBA ---
def cargar_textura(path):
    try:
        img = Image.open(path)
        img = img.convert('RGBA')
        data = np.array(img).astype(np.float32) / 255.0
        if data.shape[2] != 4:
            raise ValueError("La textura debe tener 4 canales (RGBA)")
        return data
    except Exception as e:
        print(f"No se pudo cargar la textura {path}: {e}")
        return None

